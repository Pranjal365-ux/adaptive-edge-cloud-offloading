{
  "uid": "offloadops-overview",
  "title": "OffloadOps Live Overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "title": "Edge decisions by destination", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (destination) (rate(edge_decisions_total[1m]))", "legendFormat": "{{destination}}" }] },
    { "id": 2, "title": "Edge p95 completion", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, policy) (rate(edge_completion_seconds_bucket[5m])))", "legendFormat": "{{policy}}" }] },
    { "id": 3, "title": "Measured queue and cloud probe", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "edge_queue_depth", "legendFormat": "queue" }, { "expr": "edge_rtt_estimate_ms", "legendFormat": "RTT ms" }, { "expr": "edge_bandwidth_estimate_mbps", "legendFormat": "probe Mbps" }] },
    { "id": 4, "title": "Synthetic cloud CPU cost", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "edge_cloud_cost_usd_total", "legendFormat": "USD model estimate" }] },
    { "id": 5, "title": "Edge worker-slot utilization", "type": "timeseries", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "targets": [{ "expr": "edge_worker_utilization_percent", "legendFormat": "Edge busy slots" }] },
    { "id": 6, "title": "Cloud worker-slot utilization", "type": "timeseries", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "targets": [{ "expr": "100 * sum(cloud_worker_slots_in_use) / clamp_min(sum(cloud_worker_slots_capacity), 1)", "legendFormat": "Cloud busy slots" }] },
    { "id": 7, "title": "Completed inspection throughput", "type": "timeseries", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 }, "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }, "targets": [{ "expr": "edge_tasks_per_minute", "legendFormat": "tasks / minute" }] }
  ]
}
